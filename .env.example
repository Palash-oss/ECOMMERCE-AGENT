# CockroachDB Connection (Read-Only)
DATABASE_URL=postgresql://<user>:<password>@<host>:26257/<database>?sslmode=verify-full
DATABASE_SSLROOTCERT=~/.postgresql/root.crt

# AI Agent LLM Provider (auto | gemini | groq)
LLM_PROVIDER=auto
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Server Config
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Security & JWT Auth
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting & Spend Cap
RATE_LIMIT_PER_MINUTE=20
DAILY_TOKEN_BUDGET=250000
MONTHLY_SPEND_CAP_USD=50.00
